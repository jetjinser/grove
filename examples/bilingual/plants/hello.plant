@use-commands{bilingual}

@title{A bilingual note}
@summary{One idea in English and Chinese.}
@published{2026-10-06}
@tag["i18n"]

@paragraph{This page shows Grove's bilingual facility: each pair holds the same
idea in two languages. Wide screens place the lanes side by side, narrow screens
stack them, and every lane carries its own language and direction.}

@bi{
  @lang["en"]{
    The grove is a small forest.
  }
  @lang["zh-Hans"]{
    树林是一片小小的森林。
  }

  @lang["en"]{
    Every tree has an ID, so links and translations can point at the same idea.
  }
  @lang["zh-Hans"]{
    每一棵树都有一个 ID，因此链接和译文可以指向同一个想法。
  }
}

@paragraph{Inline foreign terms keep their own language: @term["fr"]{une forêt}
is French for a forest, and @term["ar"]{غابة} is Arabic.}
