@use-commands{math-derivations}
@use-modules[(grove math calculation)
             ((grove math semantic) #:prefix ◆:)
             ((grove math formula) #:prefix φ:)]
@title{Polynomial differentiation}
@summary{Separate differentiation and simplification passes with replayable steps.}

@(define p @φ:read{x^3+2x})
@with-assumptions["scalar(x)"]{
@differentiate["x" p]
@differentiate["x"]{(1/2)*x^2+x*x}
@with-assumptions["scalar(y)"]{@differentiate["x"]{(x+y)^3}}
@check-derive[#:view 'full]{
  differentiate(x^3,x)
  3*x^2*differentiate(x,x)
  3*x^2*1
  3*x^2
}
@search-derive["3*x^2"]{differentiate(x^3,x)}
}

@(define report (φ:differentiate p "x" #:assumptions '("scalar(x)")))
@(paragraph (format #f "Independent derivation certificate replay: ~a"
   (math-verification-valid? (math-verify-derivation (math-report-derivation report)))))

@link["scalar-calculus"]{Elementary scalar functions}
