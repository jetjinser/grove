@use-modules[(math-derivations commands) ((grove math semantic) #:prefix ◆:)]
@title{Checked vector identities}
@summary{Explicit premises, automatic derivation, search and authored verification.}

@(define double-curl @◆:curl{@◆:curl{E}})
@with-assumptions["vector(E); smooth(E)"]{
@derive[double-curl]
@derive{@◆:divergence{@◆:curl{E}}}
@with-assumptions["div(E)=0"]{
@derive[double-curl]
@search-derive["-laplacian(E)" double-curl]
@search-derive["-laplacian(E)" double-curl #:backward? #t #:max-depth 3]
@check-derive[#:view 'full]{
  curl(curl(E))
  grad(div(E))-laplacian(E)
  zero(vector)-laplacian(E)
  -laplacian(E)
}
}
}
@with-assumptions["scalar(f); smooth(f)"]{
@derive{@◆:curl{@◆:grad{f}}}
@derive{@◆:divergence{@◆:grad{f}}}
}

@check-derive[#:assumptions "vector(E)" #:on-error 'show]{
  curl(curl(E))
  grad(div(E))-laplacian(E)
}
@link["math-capabilities"]{Notation, arithmetic and diagnostics}
