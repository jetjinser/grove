@use-commands{math-derivations}
@use-modules[((grove math formula) #:prefix φ:)
             ((grove math semantic) #:prefix ◆:)]
@title{Vector components and partial derivatives}
@summary{An ordered Cartesian basis, scalar entries, and explicit partial terms.}

@(define r3 (◆:space 'x 'y 'z))
@(define v (φ:components "x^2" "y" "sin(z)" #:space r3))
@with-assumptions[r3]{
  @math[v]
  @partial["x" #:view 'result]{x^3+2x*y}
  @partial["y" #:view 'result]{x^3+2x*y}
}
@with-assumptions["coordinate(x); parameter(a)"]{
  @partial["x" #:view 'result]{exp(a*x)}
}
@with-assumptions["coordinate(x); coordinate(y); function(f,scalar,scalar,scalar); differentiable(f)"]{
  @partial["x" #:view 'result]{x*f(x,y)}
}

@with-assumptions[r3]{
  @compute[#:view 'result]{grad(x^2+y^2+z^2)}
  @compute[#:view 'result]{div(components(x,y,z))}
  @compute[#:view 'result]{curl(components(-y,x,0))}
  @compute[#:view 'result]{laplacian(x^2+y^2+z^2)}
  @compute[#:view 'result]{dot(components(x,y,z),components(x,y,z))}
  @compute[#:view 'result]{cross(components(1,0,0),components(0,1,0))}
}
