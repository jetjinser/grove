@use-modules[(math-derivations commands) (grove math pipeline)
             ((grove math semantic) #:prefix ◆:)]
@title{Scalar normalization}
@summary{Stable ordering, combined factors, explicit expansion and retained domains.}

@with-assumptions["coordinate(x); coordinate(y); nonzero(x)"]{
@(math-completed-report->content (math-normalize "y*x+x*y"))
@(math-completed-report->content (math-simplify "x+2*x+x"))
@(math-completed-report->content (math-simplify "2*x*3*x^2"))
@(math-completed-report->content (math-simplify "(x+1)*x"))
@(math-completed-report->content (math-expand "(x+1)*(x-1)"))
@differentiate["x"]{x/x^2}
}

@(define unit-report (math-simplify "x/x" #:assumptions '("coordinate(x); nonzero(x)")))
@(define unit (math-report-result unit-report))
@math[unit]
@(math-completed-report->content (math-simplify (◆:add unit "2")
    #:assumptions '("coordinate(x); nonzero(x)")))
@(math-completed-report->content (math-simplify unit #:assumptions '("coordinate(x)"))
    #:on-error 'show)

The cancelled denominator remains a requirement of the computed value.
@link["scalar-calculus"]{Scalar differentiation}
