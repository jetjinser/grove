@use-commands{math-derivations}
@use-modules[(grove math calculation)
             (grove math presentation)
             ((grove math semantic) #:prefix ◆:)
             ((grove math formula) #:prefix φ:)
             ((grove math notation) #:prefix ◇:)]
@title{Mathematical capabilities}
@summary{Notation, exact arithmetic, checked derivations and diagnostics.}

@subtree[#:id "math-capabilities-notation-dsl"]{
  @title{Notation DSL}
  @◇:display-math{@◇:align{
    ∇ · @◇:vec{D} &= ρ
    ∇ × @◇:vec{E} &= −@◇:frac{∂@◇:vec{B}}{∂t}
  }}
  @◇:math{@◇:sub{E}{x} + @◇:sup{x}{3}}

}

@(define p @φ:read{x^3+2*x})

@subtree[#:id "math-capabilities-exact-arithmetic-and-scalar-simplification"]{
  @title{Exact arithmetic and scalar simplification}
  @(math-completed-report->content (φ:calculate "1/3+1/6"))

  @with-assumptions["scalar(x)"]{
  @(math-completed-report->content (φ:simplify "-(-x)+0*x+x^1"))
  @(math-completed-report->content (φ:collect "2*x+3*x"))
  @math[(◆:styled p #:variant 'bold)]
  @◇:math{@◇:parens[p]}
  }

}

@subtree[#:id "math-capabilities-derivations"]{
  @title{Derivations}
  @link["vector-analysis"]{Vector identities, search and authored steps}
  @link["vector-fields"]{Cartesian fields and product rules}
  @link["vector-components"]{Vector components and partial derivatives}
  @link["polynomial-differentiation"]{Polynomial differentiation and certificate replay}
  @link["semantic-checking"]{Independent checks for scalar polynomial rules and derivatives}
  @link["scalar-calculus"]{Scalar functions, declarations and domain premises}
  @link["scalar-normalization"]{Stable scalar simplification and explicit expansion}

}

@subtree[#:id "math-capabilities-bounded-failure-reports"]{
  @title{Bounded failure reports}
  @differentiate["x" #:assumptions "scalar(x)" #:max-steps 1 #:on-error 'show]{x^3}
  @search-derive["3*x^2" #:assumptions "scalar(x)" #:max-depth 0]{differentiate(x^3,x)}
  @(math-completed-report->content (φ:calculate "1/0") #:on-error 'show)

  @link["polynomial-integration"]{Polynomial antiderivatives}
  @link["polynomial-poisson"]{Polynomial Poisson particular solutions}
  @link["functions-and-coefficients"]{Multivariate functions, regularity and parameter coefficients}

}
