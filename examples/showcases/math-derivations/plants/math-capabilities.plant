@use-modules[(math-derivations commands) (grove math pipeline)
             ((grove math semantic) #:prefix ◆:)
             ((grove math notation) #:prefix ◇:)]
@title{Mathematical capabilities}
@summary{Notation, exact arithmetic, checked derivations and diagnostics.}

@heading{Notation DSL}
@◇:display-math{@◇:align{
  ∇ · @◇:vec{D} &= ρ
  ∇ × @◇:vec{E} &= −@◇:frac{∂@◇:vec{B}}{∂t}
}}
@◇:math{@◇:sub{E}{x} + @◇:sup{x}{3}}

@heading{Exact arithmetic and scalar simplification}
@(math-completed-report->content (math-calculate "1/3+1/6"))
@(define p @◆:expression{x^3+2*x})
@with-assumptions["scalar(x)"]{
@(math-completed-report->content (math-simplify "-(-x)+0*x+x^1"))
@(math-completed-report->content (math-collect "2*x+3*x"))
@math[(◆:styled p #:variant 'bold)]
@◇:math{@◇:parens[p]}
}

@heading{Derivations}
@link["vector-analysis"]{Vector identities, search and authored steps}
@link["vector-fields"]{Cartesian fields and product rules}
@link["vector-components"]{Vector components and partial derivatives}
@link["polynomial-differentiation"]{Polynomial differentiation and certificate replay}
@link["scalar-calculus"]{Scalar functions, declarations and domain premises}
@link["scalar-normalization"]{Stable scalar simplification and explicit expansion}

@heading{Bounded failure reports}
@differentiate["x" #:assumptions "scalar(x)" #:max-steps 1 #:on-error 'show]{x^3}
@search-derive["3*x^2" #:assumptions "scalar(x)" #:max-depth 0]{differentiate(x^3,x)}
@(math-completed-report->content (math-calculate "1/0") #:on-error 'show)
