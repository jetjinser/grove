@use-modules[(heat-notes commands)]

@title{Volume sources and Joule heating}
@summary{A heat-production rate per volume contributes a source term.}
@published{2026-09-28}

@paragraph{Let @tex-math{H(x,t)} be heat generated per unit volume and time, measured in @tex-math{\mathrm{W\,m^{-3}}}. In a slice, the generated energy over @tex-math{\Delta t} is approximately @tex-math{H S\Delta x\Delta t}. Add it to the incoming-minus-outgoing energy from @link["heat-0003"]{the local balance}, then divide by the slice volume and time interval.}

@tex-display-math{\rho_m c\,u_t=k u_{xx}+H.}

@paragraph{Equivalently, @tex-math{u_t=\alpha u_{xx}+f}, where @tex-math{f=H/(\rho_m c)} has units K/s. This separates transport from local production: the Laplacian spreads heat, while @tex-math{f>0} heats material in place.}

@subtree[#:id "heat-0005-a-current-carrying-wire"]{
  @title{A current-carrying wire}
  @paragraph{For a uniform wire with current density @tex-math{j} and electrical resistivity @tex-math{\rho_e}, the volumetric Joule-heating rate is @tex-math{H=j^2\rho_e}. Thus a simple model is}

  @tex-display-math{u_t=\alpha u_{xx}+\frac{j^2\rho_e}{\rho_m c}.}

  @paragraph{The notation matters: @tex-math{\rho_e} is electrical resistivity, while @tex-math{\rho_m} is mass density. The source term assumes these quantities and the current density are uniform; if they vary, retain their spatial dependence. Boundary losses can also be important in an actual wire.}

  @paragraph{More generally, any known heating mechanism can be placed in @tex-math{H}. In multiple dimensions the transport term becomes the Laplacian; @link["heat-0006"]{the final note} writes that form and checks its dimensions.}

}
