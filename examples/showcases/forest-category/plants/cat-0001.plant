@use-modules[(forest-category commands)]

@title{Category}
@summary{A small adaptation of the category definition in cat-0001.tree.}
@published{2024-05-21}

@paragraph[#:style 'lead]{A @bold{category} @tex-math{\mathcal{C}} consists of objects, morphisms, domain and codomain operations, identity morphisms, and a partially defined composition operation.}

@subtree[#:id "cat-0001-objects-and-morphisms"]{
  @title{Objects and morphisms}
  @itemize{
    @item{A collection @tex-math{\operatorname{ob}(\mathcal{C})} of objects, usually written @tex-math{A, B, C, \ldots}.}
    @item{A collection @tex-math{\operatorname{mor}(\mathcal{C})} of morphisms, usually written @tex-math{f, g, h, \ldots}.}
  }

}

@subtree[#:id "cat-0001-domain-codomain-and-composition"]{
  @title{Domain, codomain, and composition}
  @paragraph{Each morphism has a domain and a codomain. We write @tex-math{A \xrightarrow{f} B} when @tex-math{f} has domain @tex-math{A} and codomain @tex-math{B}. Composition @tex-math{fg} is defined when the codomain of @tex-math{g} is the domain of @tex-math{f}; then it has the same source as @tex-math{g} and target as @tex-math{f}.}

  @subtree{
    @title{Identity and associativity}
    @paragraph{Every object @tex-math{A} has an identity morphism @tex-math{1_A}. Composition obeys the identity and associativity laws:}
    @tex-display-math{f 1_A = f = 1_B f}
    @tex-display-math{(fg)h = f(gh)}
    @paragraph{The equations apply whenever the morphisms involved are composable.}
  }

  @paragraph{For qualifications and a discussion of notation, see @link["cat-0002"]{the remarks}.}

}
