@taxon["mathematics"]{Mathematics}
@tag["algebra"]{Algebra}
@paragraph{The @link["math-0002"]{limits} are useful. @tex-math{x^2+y^2=z^2}}
@paragraph{@image["images/algebra.svg"]{A simple diagram of an algebraic identity.}}
@tex-display-math{a^2+b^2=c^2}
@heading{A few examples}
@itemize{
  @item{Algebra describes patterns between quantities.}
  @item{The @code{x^2+y^2=z^2} identity describes a right triangle.}
}
@blockquote{Definitions make relationships easier to follow.}
@code-block{(define square (lambda (x) (* x x)))}
