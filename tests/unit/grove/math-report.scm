(use-modules ((grove math formula) #:prefix φ:) (grove math pipeline) (grove math expression)
             (grove math report) (grove math diagnostic)
             (grove math derivation) (grove math verification)
             ((grove math semantic) #:prefix ◆:) (grove render html) (grove ir)
             (srfi srfi-1) (srfi srfi-64))
(test-begin "computation result contracts")
(define facts (list (◆:space 'x 'y 'z) "scalar(u); c2(u)"))
(test-assert "math-derive returns a computation report"
  (math-report?
    (math-derive (φ:read "x+0") #:assumptions (φ:assumptions "scalar(x)"))))
(let ((report (φ:compute "x^2+x*0" #:assumptions facts)))
  (test-equal "concrete result is complete" 'complete (math-report-status report))
  (test-equal "concrete result has no unresolved derivatives" '() (math-report-unresolved report))
  (test-equal "recomputing a completed result is idempotent" (math-report-final report)
    (math-report-final (φ:compute (math-report-result report) #:assumptions facts))))
(let ((report (φ:compute "x+partial(u,y)" #:assumptions facts)))
  (test-equal "symbolic normal form is distinguished from a concrete result" 'symbolic (math-report-status report))
  (test-assert "symbolic normal form completes its computation" (math-report-complete? report))
  (test-equal "unresolved derivative retains its operand path" '((1)) (math-report-unresolved report))
  (test-assert "symbolic result remains reusable" (math-value? (math-report-result report)))
  (test-assert "even result-only rendering labels a symbolic result"
    (string-contains
      (string-concatenate (map (lambda (content) (sxml->html (content->sxml content)))
                              (math-completed-report->content report #:view 'result))) "Symbolic result")))
(let ((report (φ:compute "x+0" #:assumptions facts #:max-steps 0)))
  (test-equal "resource cutoff is explicit" 'cutoff (math-report-status report))
  (test-equal "partial computation cannot be reused as a completed result" #f (math-report-result report))
  (test-assert "prefix inspection remains available" (math-report-final report)))
(let ((report (φ:check-equation "x+partial(u,y)" "0" #:assumptions facts)))
  (test-equal "unproved equation has its own status" 'unproven (math-report-status report))
  (test-equal "unproved residual is not a result" #f (math-report-result report))
  (test-equal "unresolved equation diagnostic points to the derivative" '(1)
    (math-diagnostic-path (car (math-report-diagnostics report)))))
(let ((report (φ:compute "1/0")))
  (test-equal "invalid expression is an error rather than a cutoff" 'error (math-report-status report))
  (test-equal "invalid expression cannot expose a result" #f (math-report-result report)))
(let* ((candidate (list (make-math-derivation '((num "1")) '() '())))
       (limits (list (cons 'steps 4)))
       (passes (list (make-math-report 'pass candidate 'normal-form '() 0)))
       (path (list 1 2))
       (premises (list (list 'scalar 'x)))
       (message (string-copy "invalid input"))
       (diagnostic (make-math-diagnostic 'step 'rule path 'invalid premises message))
       (diagnostics (list diagnostic))
       (report (make-math-report 'calculation candidate 'normal-form limits 0
                                 #:diagnostics diagnostics #:passes passes)))
  (set-car! candidate #f)
  (set-car! (car limits) 'changed)
  (set-car! passes #f)
  (set-car! path 9)
  (set-car! (car premises) 'changed)
  (string-set! message 0 #\X)
  (set-car! diagnostics #f)
  (test-assert "report snapshots its candidate list"
    (and (= (length (math-report-candidates report)) 1)
         (math-derivation? (car (math-report-candidates report)))))
  (test-equal "report snapshots limits" '((steps . 4)) (math-report-limits report))
  (test-assert "report snapshots its pass list"
    (and (= (length (math-report-passes report)) 1)
         (math-report? (car (math-report-passes report)))))
  (test-assert "report snapshots diagnostic collections" (math-diagnostic? (car (math-report-diagnostics report))))
  (let ((returned (math-report-candidates report)))
    (set-car! returned #f))
  (test-assert "report accessors return independent candidate-list copies"
    (math-derivation? (car (math-report-candidates report))))
  (test-equal "diagnostics snapshot paths" '(1 2) (math-diagnostic-path diagnostic))
  (test-equal "diagnostics snapshot premises" '((scalar x)) (math-diagnostic-premises diagnostic))
  (test-equal "diagnostics snapshot message strings" "invalid input" (math-diagnostic-message diagnostic))
  (let ((returned (math-diagnostic-path diagnostic)))
    (set-car! returned 8))
  (test-equal "diagnostic accessors return independent copies" '(1 2)
    (math-diagnostic-path diagnostic)))
(test-error "math reports reject non-derivation candidates" #t
  (make-math-report 'bad '((not-a-derivation)) 'normal-form '() 0))
(test-error "math reports reject invalid diagnostics" #t
  (make-math-report 'bad '() 'normal-form '() 0 #:diagnostics '(not-a-diagnostic)))
(test-error "math reports reject invalid pass entries" #t
  (make-math-report 'bad '() 'normal-form '() 0 #:passes '(not-a-report)))
(test-error "math reports reject negative state counts" #t
  (make-math-report 'bad '() 'normal-form '() -1))

(let* ((verification (math-verify-derivation (make-math-derivation '() '() '())))
       (diagnostics (math-verification-diagnostics verification)))
  (test-assert "malformed derivation is rejected" (not (math-verification-valid? verification)))
  (set-car! diagnostics #f)
  (test-assert "verification diagnostics cannot be removed through an accessor"
    (not (math-verification-valid? verification))))
(test-end "computation result contracts")
