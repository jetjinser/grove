(define-module (tests unit grove cartesian-fixtures)
  #:use-module ((grove math formula) #:prefix φ:)
  #:use-module (grove math pipeline)
  #:use-module (grove math context)
  #:use-module (tests unit grove polynomial-oracle)
  #:use-module ((grove math semantic) #:prefix ◆:)
  #:use-module (srfi srfi-64)
  #:export (basis facts check check-equation))
(define basis (◆:space 'x 'y 'z))
(define facts (math-assumptions (list basis)))
(define (check fixture)
  (let* ((source (car fixture)) (report (φ:compute source #:assumptions (list basis)))
         (certificate (math-report-derivation report))
         (oracle (make-evaluator coordinates)))
    (test-assert source (math-report-complete? report))
    (test-equal "computed result" (φ:term (cadr fixture)) (math-report-final report))
    (test-equal "explicit passes" '(components partial simplify) (map math-report-name (math-report-passes report)))
    (test-assert "certificate replays" (math-verification-valid? (math-verify-derivation certificate)))
    (test-assert "basis retained on scalar and vector results"
      (member (φ:term basis) (math-derivation-requirements certificate)))
    (test-equal "independent polynomial result" (oracle (φ:term source))
      (oracle (math-report-final report)))
    (for-each (lambda (step)
                (test-equal "independent polynomial edge"
                  (oracle (math-derivation-step-from step))
                  (oracle (math-derivation-step-to step))))
              (math-derivation-steps certificate))))

(define (check-equation fixture)
  (let* ((report (φ:check-equation (car fixture) (cadr fixture)
                  #:assumptions (list basis)))
         (certificate (math-report-derivation report))
         (oracle (make-evaluator coordinates)))
    (test-assert "valid equation completes" (math-report-complete? report))
    (test-equal "identity residual is zero" '(num "0") (math-report-final report))
    (test-assert "equation derivation replays"
      (math-verification-valid? (math-verify-derivation certificate)))
    (for-each (lambda (step)
                (test-equal "independent oracle checks every residual edge"
                  (oracle (math-derivation-step-from step))
                  (oracle (math-derivation-step-to step))))
              (math-derivation-steps certificate))))
