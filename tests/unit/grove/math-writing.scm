(use-modules (grove render html) (language scribble spec) (system base language)
             (srfi srfi-13) (srfi srfi-64))
(define imports "@use-modules[(grove math calculation) ((grove math formula) #:prefix φ:) ((grove math semantic) #:prefix semantic:)]\n")
(define (article source)
  (scribble-evaluate-document (open-input-string (string-append imports source))
    (default-environment scribble) "writing.plant"))
(define (html source) (sxml->html (content->sxml (article source))))
(test-begin "mathematical article workflows")
(let ((output (html
  "@(define p @φ:read{x^3+2*x})\n@(define report (φ:differentiate p \"x\" #:assumptions '(\"scalar(x)\")))\n@(define dp (math-report-result report))\n@with-assumptions[\"scalar(x)\"]{\n@math[p]\n@differentiate[\"x\" p]\n@math[dp]\n@search-derive[p]{@φ:add[p \"0\"]}\n@check-derive{\n  @φ:derivative-expression{ x }{x}\n  1\n}\n}")))
  (test-assert "one defined expression serves display, computation, result reuse and search"
    (and (string-contains output "<msup>")
         (string-contains output "1 derivation found")
         (string-contains output "data-rule=\"differentiate-power\"")))
  (test-assert "computed article steps retain source locations"
    (string-contains output "data-source=\"writing.plant:")))
(let ((output (html "@derive[#:assumptions \"scalar(x)\" #:max-steps 0 #:on-error 'show]{x+0}")))
  (test-assert "derive supports the same bounded-error presentation as differentiate"
    (and (string-contains output "step limit reached") (not (string-contains output "<math ")))))
(let ((output (html "@derive[#:assumptions \"scalar(x)\" #:rules '() #:on-error 'show]{x+0}")))
  (test-assert "derive reports an excluded transition without claiming equality"
    (and (string-contains output "no selected math rewrite rule") (not (string-contains output "<math ")))))
(test-error "a requested derivation with no applicable transition still raises by default" #t
  (article "@derive[#:rules '()]{1}"))
(test-assert "derive exposes the term-size budget"
  (string-contains (html "@derive[#:max-term-size 1 #:on-error 'show]{1+1}") "term-size limit"))
(let ((output (html "@search-derive[\"x\" #:assumptions \"scalar(x)\" #:backward? #t #:rules '(add-zero) #:max-depth 1]{x+0}")))
  (test-assert "the same author command supports backward search with forward display order"
    (and (string-contains (string-downcase output) "search-backward")
         (string-contains output "1 derivation found")
         (string-contains output "data-rule=\"add-zero\""))))
(test-assert "search exposes result count instead of requiring Scheme report plumbing"
  (string-contains
    (html "@search-derive[\"x+y\" #:assumptions \"scalar(x); scalar(y)\" #:rules '(add-zero) #:max-results 2]{(x+0)+(y+0)}")
    "2 derivations found"))
(test-assert "search exposes the term-size budget"
  (string-contains
    (html "@search-derive[\"x\" #:assumptions \"scalar(x)\" #:max-term-size 1]{x+0}")
    "term-size limit"))
(test-error "search direction is explicitly validated" #t
  (article "@search-derive[\"1\" #:backward? 'yes]{1}"))
(test-assert "authored chains may name the intended rule and path"
  (string-contains
    (html "@check-derive[#:assumptions \"scalar(x)\" #:rules '(add-zero) #:steps '((add-zero ())) #:view 'full]{x+0\nx}")
    "data-rule=\"add-zero\""))
(test-assert "authored rule selections are enforced"
  (string-contains
    (html "@check-derive[#:assumptions \"scalar(x)\" #:rules '() #:steps '((add-zero ())) #:on-error 'show]{x+0\nx}")
    "excluded"))
(test-assert "later-pass failures explain the generating rule rather than claiming authored generated text"
  (string-contains
    (html "@differentiate[\"x\" #:assumptions \"scalar(x)\" #:max-steps 2 #:on-error 'show]{x^1}")
    "Generated by Power rule from this source."))
(let ((output
        (html
          (string-append
            "@(define source @φ:read{x^3+2*x})\n"
            "@with-assumptions[\"coordinate(x)\"]{\n"
            "@differentiate[\"x\" source]\n"
            "@math[(math-report-result (φ:differentiate source \"x\"))]\n"
            "}\n"
            "@(format #f \"outside reason: ~a\" (math-report-reason (φ:differentiate source \"x\")))"))))
  (test-assert "a local assumption scope is shared by article commands and Formula calls, then ends"
    (and (string-contains output "data-rule=\"differentiate-power\"")
         (string-contains output "outside reason: type-error"))))
(test-end "mathematical article workflows")
