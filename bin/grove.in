;; Installed libraries and optional caller paths share Guile's normal load paths.
(set! %load-path (cons "@GUILE_MODULE_DIR@" %load-path))
(set! %load-compiled-path (cons "@GUILE_OBJECT_DIR@" %load-compiled-path))
(use-modules (grove cli))
(exit (main (cdr (command-line))))
