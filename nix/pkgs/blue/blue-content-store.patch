   #:use-module (blue store)
   #:use-module (blue types)
-  #:use-module (blue file-system path)
-  #:use-module (blue stencils guile configuration)
+   #:use-module (blue file-system path)
+   #:use-module (blue file-system utils)
+   #:use-module (blue stencils guile configuration)
   #:use-module (blue stencils guile dependency)
   #:use-module (blue stencils guile test-driver)
   #:use-module (blue stencils standard configuration)
@@ -140,14 +141,26 @@ (define-blue-class <guile-module>
 
 (define-blue-method (ask-build-key (this <guile-module>))
   (vector
-   (buildable-inputs this)
    (buildable-outputs this)
-   (guile-load-path this)
-   (guile-load-compiled-path this)
    (guile-warnings this)
    (guile-warning-level this)
    (guile-optimizations this)
-   (guile-optimization-level this)))
+   (guile-optimization-level this)
+   ;;     The content digest of every input and the compiler version
+   ;;     join the key: a changed source or a changed compiler
+   ;;     invalidates the build even when timestamps are misleading,
+   ;;     such as after a branch switch or in a fresh checkout.
+   ;;     Input paths are deliberately left out - they are
+   ;;     canonicalized to checkout-local absolutes, and keeping them
+   ;;     would make the key differ between checkouts of the same
+   ;;     project, defeating the shared store.  The load path is
+   ;;     likewise left out - its effect on the compiled bytes is
+   ;;     captured by the input contents.
+   (map file-digest (buildable-inputs this))
+   (effective-version)))
+
+(define-blue-method (shareable-output? (this <guile-module>))
+  #t)
 
