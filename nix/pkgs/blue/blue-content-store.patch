diff --git a/blue/file-system/utils.scm b/blue/file-system/utils.scm
index e468f97..e236302 100644
--- a/blue/file-system/utils.scm
+++ b/blue/file-system/utils.scm
@@ -4,8 +4,10 @@
 ;;; blue/file-system/utils.scm --- File-system utilities.
 
 (define-module (blue file-system utils)
+  #:use-module (rnrs bytevectors)
   #:use-module ((srfi srfi-19) #:prefix srfi-19:)
   #:export (
+            file-digest
             file-is-dangling-symlink?
             file-is-symlink?
             file-timestamp
@@ -23,3 +25,23 @@ (define (file-is-symlink? file-name)
 (define (file-is-dangling-symlink? file-name)
   (and (file-is-symlink? file-name)
        (not (false-if-exception (stat file-name)))))
+
+(define (file-digest file-name)
+  "Return a stable FNV-1a digest of the content of FILE-NAME as a hex
+string, or #f when the file cannot be read.  This is a cache key, not
+a cryptographic digest."
+  (false-if-exception
+   (call-with-input-file file-name
+     (lambda (port)
+       (let loop ((hash 14695981039346656037))
+         (let ((chunk (get-bytevector-some port)))
+           (if (eof-object? chunk)
+               (number->string hash 16)
+               (let inner ((h hash) (i 0) (n (bytevector-length chunk)))
+                 (if (= i n)
+                     (loop h)
+                     (inner (logand (* (logxor h (bytevector-u8-ref chunk i))
+                                       1099511628211)
+                                    #xffffffffffffffff)
+                            (+ i 1)
+                            n))))))))))
