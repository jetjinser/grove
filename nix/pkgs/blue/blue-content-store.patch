--- a/blue/build.scm
+++ b/blue/build.scm
@@ -6,6 +6,7 @@ (define-module (blue build)
   #:use-module (blue computation)
   #:use-module (blue debugging backtrace)
   #:use-module (blue exceptions)
+  #:use-module (rnrs bytevectors)
   #:use-module (blue fibers channels)
   #:use-module (blue fibers conditions)
   #:use-module (blue fibers deque)
@@ -1070,6 +1071,48 @@ (define (push-progress! logs)
   errors)
 
 
+(define-blue-method (shareable-output? (this <buildable>))
+  ;; Only buildables whose build key covers the content of their
+  ;; inputs may restore outputs from the shared store; for others the
+  ;; key says nothing about the bytes that were compiled or generated.
+  #f)
+
+;;; Restore the bytes of OUTPUT from the content store keyed by
+;;; CONTENT-KEY.  Return #t when the output was restored, #f when the
+;;; store has no such blob or the blob is unusable - a corrupt entry
+;;; is treated as a cache miss, never as an error.
+(define (copy-port* input output)
+  (let loop ((chunk (get-bytevector-some input)))
+    (unless (eof-object? chunk)
+      (put-bytevector output chunk)
+      (loop (get-bytevector-some input)))))
+
+(define (restore-output-from-store! content-key output)
+  (let ((path (store-file-path content-key "outputs")))
+    (format (current-error-port)
+            "BLUE-TRY output=~s key-hex=~s blob-exists=~s cwd=~a\n"
+            output
+            (and (number? content-key) (number->string content-key 16))
+            (and path (file-exists? path))
+            (getcwd))
+    (catch #t
+      (lambda ()
+        (call-with-store-input content-key
+          (lambda (port)
+            (mkdir-p (dirname output))
+            (let ((temp (string-append output ".restore-tmp")))
+              (call-with-output-file temp
+                (lambda (out)
+                  (copy-port* port out))
+                #:binary #t)
+              (rename-file temp output)))
+          (lambda ()
+            #f)
+          #:namespace "outputs"
+          #:binary? #t))
+      (lambda args
+        #f))))
+
 (define-blue-method (ask-build-request
                      context
                      (this <buildable>))
@@ -1110,22 +1153,55 @@ (define this-build-key-in-store
   (define this-build-key-now
     (ask-build-key this))
 
+  (define shareable?
+    (shareable-output? this))
+
+  ;;     The artifact blob is keyed by the build definition plus the
+  ;;     blueprint-relative outputs - never by the canonicalized
+  ;;     output path, which is checkout-local - so every checkout
+  ;;     whose definition matches can restore the output instead of
+  ;;     rebuilding it.
+  (define content-key
+    (and shareable?
+         (hash (list this-build-key-now (buildable-outputs this)))))
+
+
+
   (define (make-request why)
     (let ((fresh? (not (equal? this-build-key-now this-build-key-in-store))))
       (make-build-request
        this  why
        #:fresh? fresh?
        #:after-build
-       (and fresh?
-            (lambda ()
-              (store-set! this-output-hash this-build-key-now
-                          #:namespace "buildable"))))))
+       (lambda ()
+         (store-set! this-output-hash this-build-key-now
+                     #:namespace "buildable")
+         (when content-key
+           (catch #t
+             (lambda ()
+               (call-with-store-output
+                content-key
+                (lambda (port)
+                  (call-with-input-file this-output
+                    (lambda (input)
+                      (copy-port* input port))
+                    #:binary #t))
+                 #:namespace "outputs"
+                 #:binary? #t))
+              (lambda args #f)))))))
 
   (cond
    ((not (buildable-enabled? this))
     #f)
    ((force-build?)
     (make-request "parameter #:force-build? is #t"))
+   ((and shareable?
+         (restore-output-from-store! content-key this-output))
+    ;;     The blob exists under the hash of the full build
+    ;;     definition: its existence is the proof that this exact
+    ;;     definition produced these bytes, whether the store has
+    ;;     seen this checkout before or not.
+    #f)
    ((not this-output-timestamp)
     (make-request
      (format #f "output `~a' does not exist" this-output)))
