+            ;; Compile before tracing: macro expansion and the interpreter
+            ;; are not test execution and can be extremely costly under hooks.
+            (let* ((port (mkstemp (string-append (or (getenv "TMPDIR") "/tmp")
+                                               "/blue-coverage-XXXXXX")))
+                   (object (port-filename port)))
+              (close-port port)
+              (dynamic-wind
+                (lambda () #t)
+                (lambda ()
