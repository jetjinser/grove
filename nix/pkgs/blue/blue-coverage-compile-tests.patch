                (lambda ()
                  (raise-exception
                   (make-exception
@@ -245,14 +248,25 @@
                     "Test-suite timeout after LIMIT")))))))
           (cond
            ((and enable-coverage? cov-file)
-            (let ((coverage-data (with-code-coverage run-tests)))
-              (call-with-output-file cov-file
-                (lambda (cov-port)
