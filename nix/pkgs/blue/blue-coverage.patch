new file mode 100644
index 0000000..a90f7bf
--- /dev/null
+++ b/tests/unit/blue/debugging/coverage.scm
@@ -0,0 +1,50 @@
+;;; SPDX-License-Identifier: LGPL-3.0-or-later
+;;; SPDX-FileCopyrightText: 2026 Jinser Kafka <aimer@purejs.icu>
+
+(define-module (tests unit blue debugging coverage)
+  #:use-module (blue debugging coverage)
+  #:use-module (blue stencils guile test-driver)
+  #:use-module (ice-9 textual-ports)
+  #:use-module (ice-9 string-fun)
+  #:use-module (srfi srfi-1)
+  #:use-module (srfi srfi-13)
+  #:use-module (system base compile)
+  #:use-module (tests test-suite))
+
+(test-begin "coverage export")
+(let* ((root (mkdtemp "/tmp/blue-coverage-test-XXXXXX"))
+       (source (string-append root "/fixture.scm"))
+       (object (string-append root "/fixture.go"))
+       (entry (string-append root "/run.scm"))
+       (report (string-append root "/fixture.cov")))
+  (dynamic-wind
+    (lambda ()
+      (call-with-output-file source
+        (lambda (port)
+          (display "(define-module (coverage-fixture) #:use-module (srfi srfi-64) #:export (run-fixture))\n(define (run-fixture)\n(test-begin \"fixture\")\n(test-assert \"excluded assertion\" #t) ; coverage-exclude-line\n(test-assert \"included assertion\" #t)\n(test-end \"fixture\"))\n" port)))
+      (compile-file source #:output-file object)
+      (call-with-output-file entry (lambda (port) (write `(begin (load-compiled ,object) ((module-ref (resolve-module '(coverage-fixture)) 'run-fixture))) port))))
+    (lambda ()
+      (test-assert "coverage without an explicit filter executes successfully"
+        (run-test entry #:enable-coverage? #t #:cov-file report
+          #:load-path (list (getenv "BLUE_SRCDIR"))
+          #:load-compiled-path (if (getenv "BLUE_TEST_OBJECTS")
+                                  (list (getenv "BLUE_TEST_OBJECTS")) %load-compiled-path)
+          #:time-limit 60))
+      (let* ((text (call-with-input-file report get-string-all))
+             (lines (string-split text #\newline))
+             (start (find-tail (lambda (line) (string=? line (string-append "SF:" source))) lines))
+             (record (and start (take-while (lambda (line) (not (string=? line "end_of_record"))) (cdr start)))))
+        (test-assert "the default filter includes the tested source" record)
+        (when record
+          (let* ((data (filter (lambda (line) (string-prefix? "DA:" line)) record))
+                 (hit (count (lambda (line) (positive? (string->number (cadr (string-split line #\,))))) data)))
+            (test-assert "excluded source lines are absent from DA records"
+              (not (any (lambda (line) (string-prefix? "DA:4," line)) data)))
+            (test-assert "line records contain executions" (positive? hit))
+            (test-assert "LF agrees with the emitted line records"
+              (member (format #f "LF:~a" (length data)) record))
+            (test-assert "LH agrees with the emitted execution counts"
+              (member (format #f "LH:~a" hit) record))))))
+    (lambda () (system* "rm" "-rf" root))))
+(test-end "coverage export")
