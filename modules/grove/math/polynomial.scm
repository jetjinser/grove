(define-module (grove math polynomial)
  #:use-module ((grove math exact-polynomial) #:prefix exact:)
  #:use-module (grove math number)
  #:use-module (grove math term)
  #:use-module (ice-9 match)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:export (math-polynomial? math-term->polynomial math-polynomial->term
            polynomial-add polynomial-scale polynomial-partial polynomial-integral
            polynomial-zero? polynomial-variables polynomial-poisson))

;; Polynomials over the field of rational parameter expressions. The numerator
;; uses the bounded exact sparse IR; the denominator is independent of every
;; differentiation coordinate. Domain premises belong to the surrounding value
;; and certificate, so reduction of a fraction cannot discard them.
(define-record-type <polynomial>
  (make-polynomial numerator denominator denominator-source)
  math-polynomial?
  (numerator polynomial-numerator)
  (denominator polynomial-denominator)
  (denominator-source polynomial-denominator-source))
(define (polynomial-variables p) (exact:polynomial-variables (polynomial-numerator p)))
(define (polynomial-zero? p) (exact:polynomial-zero? (polynomial-numerator p)))
(define (denominator-product a b)
  (cond ((equal? a '(num "1")) b) ((equal? b '(num "1")) a) (else `(* ,a ,b))))
(define* (wrap numerator denominator #:optional (source #f))
  (let ((n (math-number-value (exact:math-polynomial->term denominator))))
    (if (and n (not (zero? n)))
        (make-polynomial (exact:polynomial-scale numerator (/ n))
          (exact:polynomial-scale denominator (/ n)) '(num "1"))
        (make-polynomial numerator denominator (or source (exact:math-polynomial->term denominator))))))
(define (polynomial-scale p n)
  (wrap (exact:polynomial-scale (polynomial-numerator p) n) (polynomial-denominator p) (polynomial-denominator-source p)))
(define (polynomial-add a b)
  (let ((ad (polynomial-denominator a)) (bd (polynomial-denominator b)))
    (if (equal? (exact:math-polynomial->term ad) (exact:math-polynomial->term bd))
        (wrap (exact:polynomial-add (polynomial-numerator a) (polynomial-numerator b)) ad (polynomial-denominator-source a))
        (wrap (exact:polynomial-add
                (exact:polynomial-multiply (polynomial-numerator a) bd)
                (exact:polynomial-multiply (polynomial-numerator b) ad))
              (exact:polynomial-multiply ad bd)
              (denominator-product (polynomial-denominator-source a) (polynomial-denominator-source b))))))
(define (multiply a b)
  (wrap (exact:polynomial-multiply (polynomial-numerator a) (polynomial-numerator b))
        (exact:polynomial-multiply (polynomial-denominator a) (polynomial-denominator b))
        (denominator-product (polynomial-denominator-source a) (polynomial-denominator-source b))))
(define (coordinate-independent? p variable)
  (exact:polynomial-zero? (exact:polynomial-partial (polynomial-denominator p) variable)))
(define (polynomial-partial p variable)
  (unless (coordinate-independent? p variable) (error "parameter coefficient depends on differentiation coordinate" variable))
  (wrap (exact:polynomial-partial (polynomial-numerator p) variable) (polynomial-denominator p) (polynomial-denominator-source p)))
(define (polynomial-integral p variable)
  (unless (coordinate-independent? p variable) (error "parameter coefficient depends on integration coordinate" variable))
  (wrap (exact:polynomial-integral (polynomial-numerator p) variable) (polynomial-denominator p) (polynomial-denominator-source p)))
(define (polynomial-poisson p axes)
  (unless (every (lambda (axis) (coordinate-independent? p axis)) axes)
    (error "parameter coefficient depends on a Poisson coordinate"))
  (wrap (exact:polynomial-poisson (polynomial-numerator p) axes) (polynomial-denominator p) (polynomial-denominator-source p)))

(define (math-term->polynomial term facts)
  "Parse coordinate polynomials with exact rational parameter coefficients.
Coordinate-dependent denominators are excluded; definedness is checked by the domain pass."
  (define unit (exact:math-term->polynomial '(num "1") facts))
  (define (parameter-only? term)
    (every (lambda (path)
             (let ((local (math-term-at-path term path)))
               (or (not (eq? (car local) 'var)) (member `(parameter ,local) facts))))
           (math-term-paths term)))
  (define (parse term)
    (let ((exact (exact:math-term->polynomial term facts)))
      (if exact (wrap exact unit)
          (match term
            (('- a) (let ((a (parse a))) (and a (polynomial-scale a -1))))
            (((or '+ '- '*) a b)
             (let ((a (parse a)) (b (parse b)))
               (and a b (case (car term)
                          ((+) (polynomial-add a b))
                          ((-) (polynomial-add a (polynomial-scale b -1)))
                          ((*) (multiply a b))))))
            (('/ a b)
             (and (parameter-only? b)
                  (let ((a (parse a)) (source b) (b (parse b)))
                    (and a b (not (polynomial-zero? b))
                         (wrap (exact:polynomial-multiply (polynomial-numerator a) (polynomial-denominator b))
                               (exact:polynomial-multiply (polynomial-denominator a) (polynomial-numerator b))
                               (denominator-product (polynomial-denominator-source a)
                                   (if (equal? (exact:math-polynomial->term (polynomial-denominator b)) '(num "1"))
                                       source (exact:math-polynomial->term (polynomial-numerator b)))))))))
            (('^ a ('num n))
             (let ((a (parse a)) (n (math-natural-value n)))
               (and a n (begin
                 (when (> n 64) (throw 'polynomial-limit "polynomial power exceeds 64"))
                 (let power ((n n) (result (wrap unit unit)))
                   (if (zero? n) result (power (- n 1) (multiply result a))))))))
            (_ #f)))))
  (parse term))

(define (math-polynomial->term p)
  (let ((numerator (exact:math-polynomial->term (polynomial-numerator p)))
        (denominator (exact:math-polynomial->term (polynomial-denominator p))))
    (cond ((polynomial-zero? p) '(num "0"))
          ((equal? denominator '(num "1")) numerator)
          ((equal? numerator denominator) '(num "1"))
          (else `(/ ,numerator ,(polynomial-denominator-source p))))))
