(define-module (grove math domain)
  #:use-module (grove math term)
  #:use-module (grove math operator)
  #:use-module (grove math diagnostic)
  #:use-module (grove math declaration)
  #:use-module (grove math premise)
  #:use-module (grove math polynomial)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (math-domain-diagnostics))

(define (polynomial-domain-diagnostic term assumptions path)
  (catch 'polynomial-limit
    (lambda ()
      (and (not (math-term->polynomial (cadr term) assumptions))
           (make-math-diagnostic #f #f path 'unsupported-expression '()
             "Polynomial calculus requires exact scalar polynomials in independent coordinates/parameters and numeric nonzero denominators")))
    (lambda (key message)
      (make-math-diagnostic #f #f path 'polynomial-limit '() message))))

;; Structural validity is broader than the executable vocabulary. Unknown
;; function applications remain representable and displayable, not computable.
(define* (math-domain-diagnostics term #:optional (pass 'compute) (assumptions '()))
  (filter-map
    (lambda (path)
      (let* ((local (math-term-at-path term path)) (name (car local)))
        (cond
          ((and (eq? pass 'components) (memq name '(grad div curl laplacian))
                (not (any math-space-declaration? assumptions)))
           (make-math-diagnostic #f #f path 'missing-premise '()
             "Cartesian operator expansion requires an active ordered space"))
          ((and (eq? pass 'components) (memq name '(grad div curl laplacian))
                (not (math-premise-known? assumptions
                       `(,(if (eq? name 'laplacian) 'c2 'differentiable) ,(cadr local)))))
           (make-math-diagnostic #f #f path 'missing-premise
             (list `(,(if (eq? name 'laplacian) 'c2 'differentiable) ,(cadr local)))
             "Cartesian operator expansion requires operand regularity"))
          ((and (eq? name 'components)
                (not (any math-space-declaration? assumptions)))
           (make-math-diagnostic #f #f path 'missing-premise '()
             "vector components require an active ordered Cartesian space"))
          ((and (eq? name 'poisson) (not (any math-space-declaration? assumptions)))
           (make-math-diagnostic #f #f path 'missing-premise '()
             "Poisson computation requires an active ordered Cartesian space"))
          ((and (memq name '(partial antiderivative poisson)) (not (eq? (caaddr local) 'var)))
           (make-math-diagnostic #f #f (append path '(1)) 'unsupported-expression '()
             (format #f "~a requires an independent coordinate variable" name)))
          ((and (memq name '(partial antiderivative poisson))
                (eq? (math-variable-role assumptions (caddr local)) 'parameter))
           (make-math-diagnostic #f #f (append path '(1)) 'unsupported-expression '()
             (format #f "a constant parameter cannot be used as a ~a coordinate" name)))
          ((and (memq name '(partial antiderivative poisson)) (not (member `(coordinate ,(caddr local)) assumptions)))
           (make-math-diagnostic #f #f (append path '(1)) 'missing-premise
             (list `(coordinate ,(caddr local)))
             (format #f "~a requires an explicit independent coordinate" name)))
          ((and (eq? name 'poisson)
                (not (any (lambda (fact) (and (math-space-declaration? fact) (member (caddr local) (cdr fact)))) assumptions)))
           (make-math-diagnostic #f #f (append path '(1)) 'unsupported-expression '()
             "The Poisson construction coordinate must belong to the active Cartesian space"))
          ((and (memq name '(antiderivative poisson))
                (polynomial-domain-diagnostic local assumptions path)) => identity)
          ((and (eq? name 'num)
                (or (string-null? (cadr local))
                    (not (string-every (lambda (char) (char<=? #\0 char #\9)) (cadr local)))))
           (make-math-diagnostic #f #f path 'unsupported-expression '()
             (format #f "~a requires decimal integer literals; ~s can still be displayed" pass (cadr local))))
          ((and (eq? name '^)
                (not (and (eq? (car (caddr local)) 'num)
                          (not (string-null? (cadr (caddr local))))
                          (string-every (lambda (c) (char<=? #\0 c #\9)) (cadr (caddr local))))))
           (make-math-diagnostic #f #f (append path '(1)) 'unsupported-expression '()
             "computation currently supports only natural-number exponents"))
          ((and (math-field-coordinates assumptions name)
                (not (member (cons 'space (math-field-coordinates assumptions name)) assumptions)))
           (make-math-diagnostic #f #f path 'missing-premise
             (list (cons 'space (math-field-coordinates assumptions name)))
             "field computation requires its declared Cartesian coordinate space"))
          ((and (not (memq name '(var num zero)))
             (not (any (lambda (signature) (eq? name (car signature)))
                       math-operator-signatures))
             (not (math-function-signature assumptions name)))
             (make-math-diagnostic #f #f path 'unsupported-expression '()
               (format #f "~a does not support operator ~a; this expression can still be displayed" pass name)))
          (else #f))))
    (math-term-paths term)))
