(define-module (grove math types)
  #:use-module (grove relation)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:export (math-typeo
            math-infer-type
            math-type-diagnostic
            math-typed-term?
            math-typed-term-term
            math-typed-term-type))

(define-record-type <math-typed-term>
  (make-math-typed-term term type)
  math-typed-term?
  (term math-typed-term-term)
  (type math-typed-term-type))

(define (facto assumptions fact)
  (conde
    ((fresh (rest)
       (== `(,fact . ,rest) assumptions)))
    ((fresh (head rest)
       (== `(,head . ,rest) assumptions)
       (=/= head fact)
       (facto rest fact)))))

(define (math-typeo assumptions term type)
  (conde
    ((== term '(zero vector)) (== type 'vector))
    ((fresh (name)
       (== `(var ,name) term)
       (facto assumptions `(scalar (var ,name)))
       (== type 'scalar)))
    ((fresh (name)
       (== `(var ,name) term)
       (facto assumptions `(vector (var ,name)))
       (== type 'vector)))
    ((fresh (number)
       (== `(num ,number) term)
       (== type 'scalar)))
    ((fresh (operand operand-type)
       (== `(- ,operand) term)
       (math-typeo assumptions operand operand-type)
       (== type operand-type)))
    ((fresh (left right operand-type)
       (== `(+ ,left ,right) term)
       (math-typeo assumptions left operand-type)
       (math-typeo assumptions right operand-type)
       (== type operand-type)))
    ((fresh (left right operand-type)
       (== `(- ,left ,right) term)
       (math-typeo assumptions left operand-type)
       (math-typeo assumptions right operand-type)
       (== type operand-type)))
    ((fresh (left right)
       (== `(* ,left ,right) term)
       (math-typeo assumptions left 'scalar)
       (math-typeo assumptions right 'scalar)
       (== type 'scalar)))
    ((fresh (left right)
       (== `(* ,left ,right) term)
       (math-typeo assumptions left 'vector)
       (math-typeo assumptions right 'scalar)
       (== type 'vector)))
    ((fresh (left right)
       (== `(* ,left ,right) term)
       (math-typeo assumptions left 'scalar)
       (math-typeo assumptions right 'vector)
       (== type 'vector)))
    ((fresh (numerator denominator)
       (== `(/ ,numerator ,denominator) term)
       (math-typeo assumptions numerator 'scalar)
       (math-typeo assumptions denominator 'scalar)
       (== type 'scalar)))
    ((fresh (numerator denominator)
       (== `(/ ,numerator ,denominator) term)
       (math-typeo assumptions numerator 'vector)
       (math-typeo assumptions denominator 'scalar)
       (== type 'vector)))
    ((fresh (base exponent)
       (== `(^ ,base ,exponent) term)
       (math-typeo assumptions base 'scalar)
       (math-typeo assumptions exponent 'scalar)
       (== type 'scalar)))
    ((fresh (base index)
       (== `(sub ,base ,index) term)
       (math-typeo assumptions base type)
       (conde ((== type 'scalar)) ((== type 'vector)))))
    ((fresh (left right)
       (== `(= ,left ,right) term)
       (math-typeo assumptions left 'scalar)
       (math-typeo assumptions right 'scalar)
       (== type 'proposition)))
    ((fresh (left right)
       (== `(= ,left ,right) term)
       (math-typeo assumptions left 'vector)
       (math-typeo assumptions right 'vector)
       (== type 'proposition)))
    ((fresh (argument)
       (== `(grad ,argument) term)
       (math-typeo assumptions argument 'scalar)
       (== type 'vector)))
    ((fresh (argument)
       (== `(curl ,argument) term)
       (math-typeo assumptions argument 'vector)
       (== type 'vector)))
    ((fresh (argument)
       (== `(div ,argument) term)
       (math-typeo assumptions argument 'vector)
       (== type 'scalar)))
    ((fresh (argument)
       (== `(laplacian ,argument) term)
       (math-typeo assumptions argument type)
       (conde ((== type 'scalar)) ((== type 'vector)))))))

(define (math-infer-type assumptions term)
  (let ((types
          (delete-duplicates
            (run* (type)
              (math-typeo assumptions term type)))))
    (and (= (length types) 1)
         (make-math-typed-term term (car types)))))

(define (math-type-diagnostic assumptions term)
  (define (diagnose term)
    (cond
      ((and (pair? term) (eq? (car term) 'var))
       (let* ((name (cadr term))
              (scalar? (member `(scalar ,term) assumptions))
              (vector? (member `(vector ,term) assumptions)))
         (cond
           ((and scalar? vector?)
            (format #f "variable ~a has conflicting scalar and vector declarations"
                    name))
           ((not (or scalar? vector?))
            (format #f "variable ~a has no type declaration; add scalar(~a) or vector(~a)"
                    name name name))
           (else #f))))
      ((and (pair? term) (memq (car term) '(curl grad div))
            (= (length term) 2))
       (let* ((operator (car term))
              (argument (cadr term))
              (expected (if (eq? operator 'grad) 'scalar 'vector))
              (typed (math-infer-type assumptions argument)))
         (cond
           ((and typed (not (eq? (math-typed-term-type typed) expected)))
            (format #f "~a requires a ~a operand, but this expression is ~a"
                    operator expected (math-typed-term-type typed)))
           ((not typed)
            (if (and (pair? argument) (eq? (car argument) 'var)
                     (not (member `(scalar ,argument) assumptions))
                     (not (member `(vector ,argument) assumptions)))
                (format #f "~a requires a ~a operand; add ~a(~a)"
                        operator expected expected (cadr argument))
                (or (diagnose argument)
                    (format #f "cannot determine the type required by ~a"
                            operator))))
           (else #f))))
      ((and (pair? term) (list? term))
       (let loop ((children (cdr term)))
         (and (pair? children)
              (or (diagnose (car children))
                  (loop (cdr children))))))
      (else #f)))
  (or (diagnose term)
      (format #f "no type rule applies to ~s" term)))
