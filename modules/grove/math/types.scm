(define-module (grove math types)
  #:use-module (ice-9 format)
  #:use-module (grove relation)
  #:use-module ((grove relation dsl) #:select (project))
  #:use-module (grove math operator)
  #:use-module (grove math assumption)
  #:use-module (grove math term)
  #:use-module (grove math diagnostic)
  #:use-module (grove math declaration)
  #:use-module (grove math function-derivative)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:export (math-typeo
            math-infer-type
            math-assumption-type-diagnostics
            math-type-diagnostic
            math-typed-term?
            math-typed-term-term
            math-typed-term-type))

(define-record-type <math-typed-term>
  (make-math-typed-term term type)
  math-typed-term?
  (term math-typed-term-term)
  (type math-typed-term-type))

(define (facto assumptions fact)
  (conde
    ((fresh (rest)
       (== `(,fact . ,rest) assumptions)))
    ((fresh (head rest)
       (== `(,head . ,rest) assumptions)
       (=/= head fact)
       (facto rest fact)))))

(define (math-typeo assumptions term type)
  (conde
    ((== term '(zero vector)) (== type 'vector))
    ((fresh (name)
       (== `(var ,name) term)
       (conde ((facto assumptions `(scalar (var ,name))))
              ((facto assumptions `(coordinate (var ,name))))
              ((facto assumptions `(parameter (var ,name)))))
       (== type 'scalar)))
    ((fresh (name signature)
       (== term `(var ,name))
       (facto assumptions `(function (var ,name) . ,signature))
       (== type 'function)))
    ((fresh (name result x y z)
       (== term `(var ,name))
       (facto assumptions `(field (var ,name) ,result ,x ,y ,z))
       (== type 'function)))
    ((fresh (name)
       (== `(var ,name) term)
       (facto assumptions `(vector (var ,name)))
       (== type 'vector)))
    ((fresh (number)
       (== `(num ,number) term)
       (== type 'scalar)))
    ((fresh (operator operands specification signature)
       (== term `(,operator . ,operands))
       (facto assumptions `(function (var ,operator) . ,specification))
       (declared-signatureo specification signature type)
       (operand-typeso assumptions operands signature)))
    ((fresh (operator operands result x y z)
       (== term `(,operator . ,operands))
       (facto assumptions `(field (var ,operator) (var ,result) ,x ,y ,z))
       (operand-typeso assumptions operands '(scalar scalar scalar))
       (== type result)))
    ((fresh (operator operands signature)
       (== term `(,operator . ,operands))
       (signatureo operator signature type)
       (operand-typeso assumptions operands signature)
       (conde
         ((=/= operator 'differentiate) (=/= operator 'partial)
          (=/= operator 'antiderivative) (=/= operator 'poisson) (=/= operator 'prime)
          (=/= operator 'darg))
         ((== operator 'darg)
          (project (assumptions term)
            (if (math-function-derivative-info assumptions term) succeed fail)))
         ((fresh (expression name)
            (conde ((== term `(partial ,expression (var ,name))))
                   ((== term `(antiderivative ,expression (var ,name))))
                   ((== term `(poisson ,expression (var ,name)))))
            (facto assumptions `(coordinate (var ,name)))))
         ((fresh (name argument)
            (== term `(prime (var ,name) ,argument))
            (facto assumptions `(function (var ,name) (var scalar) (var scalar)))))
         ((fresh (expression name)
            (== term `(differentiate ,expression (var ,name)))
            (project (assumptions name)
              (if (eq? (math-variable-role assumptions `(var ,name)) 'parameter) fail succeed)))))))))

(define signatures (make-relation math-operator-signatures #:arity 3))
(define (declared-signatureo specification inputs result)
  (conde
    ((== specification `((var ,result))) (== inputs '()))
    ((fresh (input rest remaining)
       (== specification `((var ,input) . ,rest))
       (== inputs `(,input . ,remaining))
       (declared-signatureo rest remaining result)))))
(define (signatureo operator operands result)
  (relationo signatures operator operands result))
(define (operand-typeso assumptions operands types)
  (conde
    ((== operands '()) (== types '()))
    ((fresh (operand rest type remaining)
       (== operands `(,operand . ,rest))
       (== types `(,type . ,remaining))
       (math-typeo assumptions operand type)
       (operand-typeso assumptions rest remaining)))))

(define (math-infer-type assumptions term)
  ;; Ground validation is bottom-up and memoized; math-typeo also supports
  ;; relational synthesis. Parity tests keep these evaluation paths aligned.
  (define cache (make-hash-table))
  (define (types term)
    (or (hash-ref cache term #f)
        (let ((result
                (if (memq (car term) '(var num zero))
                    (delete-duplicates (run* (type) (math-typeo assumptions term type)))
                    (let* ((name (car term))
                           (declared (math-function-signature assumptions name))
                           (signatures (append
                                         (filter (lambda (s) (eq? (car s) name)) math-operator-signatures)
                                         (if declared (list (cons name declared)) '())))
                           (children (map types (cdr term)))
                           (allowed?
                             (case name
                               ((darg) (math-function-derivative-info assumptions term))
                               ((partial antiderivative poisson) (and (eq? (caaddr term) 'var)
                                               (member `(coordinate ,(caddr term)) assumptions)))
                               ((differentiate) (and (eq? (caaddr term) 'var)
                                                 (not (eq? (math-variable-role assumptions (caddr term)) 'parameter))))
                               ((prime) (and (eq? (caadr term) 'var)
                                             (member `(function ,(cadr term) (var scalar) (var scalar)) assumptions)))
                               (else #t))))
                      (if allowed?
                          (delete-duplicates
                            (filter-map
                              (lambda (signature)
                                (and (= (length children) (length (cadr signature)))
                                     (every (lambda (choices expected) (memq expected choices)) children (cadr signature))
                                     (caddr signature))) signatures)) '())))))
          (hash-set! cache term result) result)))
  (and (math-term? term)
       (null? (math-assumption-diagnostics assumptions))
       (let ((choices (types term)))
         (and (= (length choices) 1) (make-math-typed-term term (car choices))))))

(define (math-assumption-type-diagnostics assumptions)
  (filter-map
    (lambda (fact)
      (and (memq (car fact) '(positive nonzero))
           (let ((typed (math-infer-type assumptions (cadr fact))))
             (and (or (not typed) (not (eq? (math-typed-term-type typed) 'scalar)))
                  (make-math-diagnostic #f #f '() 'type-error (list fact)
                    "sign and nonzero premises require a declared scalar expression")))))
    assumptions))

(define (math-type-diagnostic assumptions term)
  (define (diagnose term)
    (cond
      ((and (pair? term) (eq? (car term) 'var))
       (let* ((name (cadr term))
              (scalar? (math-scalar-declared? assumptions term))
              (vector? (member `(vector ,term) assumptions)))
         (cond
           ((and scalar? vector?)
            (format #f "variable ~a has conflicting scalar and vector declarations"
                    name))
           ((not (or scalar? vector? (math-function-signature assumptions name)))
            (format #f "variable ~a has no type declaration; add scalar(~a) or vector(~a)"
                    name name name))
           (else #f))))
      ((and (pair? term) (memq (car term) '(curl grad div))
            (= (length term) 2))
       (let* ((operator (car term))
              (argument (cadr term))
              (expected (if (eq? operator 'grad) 'scalar 'vector))
              (typed (math-infer-type assumptions argument)))
         (cond
           ((and typed (not (eq? (math-typed-term-type typed) expected)))
            (format #f "~a requires a ~a operand, but this expression is ~a"
                    operator expected (math-typed-term-type typed)))
           ((not typed)
            (if (and (pair? argument) (eq? (car argument) 'var)
                     (not (math-scalar-declared? assumptions argument))
                     (not (member `(vector ,argument) assumptions)))
                (format #f "~a requires a ~a operand; add ~a(~a)"
                        operator expected expected (cadr argument))
                (or (diagnose argument)
                    (format #f "cannot determine the type required by ~a"
                            operator))))
           (else #f))))
      ((and (pair? term) (math-function-signature assumptions (car term)))
       (let* ((signature (math-function-signature assumptions (car term)))
              (expected (car signature)))
         (if (not (= (length expected) (length (cdr term))))
             (format #f "function ~a expects ~a operand~:p; received ~a" (car term) (length expected) (length (cdr term)))
             (let ((types (map (lambda (operand) (math-infer-type assumptions operand)) (cdr term))))
               (if (every identity types)
                   (and (not (equal? expected (map math-typed-term-type types)))
                        (format #f "function ~a requires operand types ~s; received ~s"
                                (car term) expected (map math-typed-term-type types)))
                   (let loop ((children (cdr term)))
                     (and (pair? children) (or (diagnose (car children)) (loop (cdr children))))))))))
      ((and (pair? term) (list? term))
       (let loop ((children (cdr term)))
         (and (pair? children)
              (or (diagnose (car children))
                  (loop (cdr children))))))
      (else #f)))
  (or (let ((diagnostics (math-assumption-diagnostics assumptions)))
        (and (pair? diagnostics) (math-diagnostic-message (car diagnostics))))
      (diagnose term)
      (let* ((signatures (filter (lambda (entry)
                                  (and (eq? (car entry) (car term))
                                       (= (length (cadr entry)) (length (cdr term)))))
                                math-operator-signatures))
             (operands (map (lambda (operand) (math-infer-type assumptions operand)) (cdr term))))
        (and (pair? signatures) (every identity operands)
             (format #f "~a cannot accept operand types ~s; expected one of ~s"
                     (car term) (map math-typed-term-type operands)
                     (map cadr signatures))))
      (format #f "no type rule applies to ~s" term)))
