(define-module (grove math premise)
  #:use-module (grove math number)
  #:use-module (grove math scalar)
  #:use-module (grove math declaration)
  #:use-module (grove math term)
  #:use-module (grove math private function-derivative)
  #:use-module ((grove math private exact-polynomial) #:prefix exact:)
  #:use-module (grove math diagnostic)
  #:use-module (srfi srfi-1)
  #:export (math-premise-known? math-definedness-diagnostics math-domain-premises math-requirement-diagnostics math-context-premises))

(define (math-context-premises facts term)
  (delete-duplicates
    (append-map (lambda (path)
                  (let* ((local (math-term-at-path term path))
                         (axes (math-field-coordinates facts (car local))))
                    (append
                      (cond (axes (list (cons 'space axes)))
                            ((memq (car local) '(components poisson grad div curl laplacian))
                             (let ((space (find math-space-declaration? facts)))
                               (if space (list space) '())))
                            (else '()))
                      (if (memq (car local) '(partial darg antiderivative poisson grad div curl laplacian /))
                          (let ((variables (map (lambda (path) (math-term-at-path local path))
                                                (math-term-paths local))))
                            (filter (lambda (fact)
                                      (and (memq (car fact) '(coordinate parameter))
                                           (member (cadr fact) variables))) facts)) '()))))
                (math-term-paths term)) equal?))

;; Regularity is a finite derivative budget, or C-infinity. A derivative
;; consumes one order; a Laplacian consumes two. No C1 -> C2 promotion.
(define (regular? facts term predicate)
  (define order (case predicate ((differentiable) 1) ((c2) 2) (else +inf.0)))
  (define (at-order term order)
    (or (any (lambda (fact)
               (and (memq (car fact) '(differentiable c2 smooth)) (equal? (cadr fact) term)
                    (>= (case (car fact) ((differentiable) 1) ((c2) 2) (else +inf.0)) order))) facts)
      (case (car term)
        ((num zero) #t)
        ((var) (or (member `(coordinate ,term) facts) (member `(parameter ,term) facts)
                   (any (lambda (fact) (and (math-space-declaration? fact) (member term (cdr fact)))) facts)))
        ((+ - * / ^ dot cross sin cos exp log components antiderivative poisson)
         (every (lambda (child) (at-order child order)) (cdr term)))
        ((grad div curl partial differentiate) (at-order (cadr term) (+ order 1)))
        ((laplacian) (at-order (cadr term) (+ order 2)))
        ((prime) (and (at-order (cadr term) (+ order 1)) (at-order (caddr term) order)))
        ((darg)
         (let ((info (math-function-derivative-info facts term)))
           (and info (at-order `(var ,(car info)) (+ order (length (caddr info))))
                (every (lambda (arg) (at-order arg order)) (cadr info)))))
        (else
         (and (math-function-signature facts (car term))
              (at-order `(var ,(car term)) order)
              (every (lambda (child) (at-order child order)) (cdr term)))))))
  (at-order term order))

(define (math-domain-premises term)
  (delete-duplicates
    (append
    (append-map (lambda (path)
                  (let ((local (math-term-at-path term path)))
                    (if (eq? (car local) 'differentiate)
                        (math-function-differentiation-premises (cadr local)) '())))
                (math-term-paths term))
    (filter-map (lambda (path)
                  (let ((local (math-term-at-path term path)))
                    (case (car local)
                      ((/) `(nonzero ,(caddr local)))
                      ((log) `(positive ,(cadr local)))
                      ((prime) `(differentiable ,(cadr local)))
                      ((darg)
                       (let ((info (math-function-derivative-shape local)))
                         (and info (math-function-derivative-premise info))))
                      ((partial) `(differentiable ,(cadr local)))
                      (else #f)))) (math-term-paths term))) equal?))

(define (math-requirement-diagnostics facts requirements)
  (filter-map (lambda (fact)
                (and (not (math-premise-known? facts fact))
                     (make-math-diagnostic #f #f '() 'missing-premise (list fact)
                       (format #f "~a: ~a"
                         (case (car fact)
                           ((smooth c2 differentiable) "retained regularity premise")
                           ((space) "retained coordinate space")
                           ((=) "retained identity premise")
                           (else "retained domain premise"))
                         (math-term->source fact)))))
              requirements))

;; Small, constructive entailment over real expressions. It neither guesses
;; variable signs nor proves arbitrary asserted equations.
(define (asserted? facts predicate term)
  (any (lambda (fact)
         (and (eq? (car fact) predicate)
              (equal? (scalar-canonical term) (scalar-canonical (cadr fact))))) facts))

(define (positive? facts term)
  (let ((number (math-number-value term)))
    (or (and number (> number 0))
        (asserted? facts 'positive term)
        (case (car term)
          ((exp) #t)
          ((*) (and (positive? facts (cadr term)) (positive? facts (caddr term))))
          ((/) (and (positive? facts (cadr term)) (positive? facts (caddr term))))
          ((^)
           (let ((n (and (eq? (caaddr term) 'num) (math-natural-value (cadr (caddr term))))))
             (and n (or (= n 0) (positive? facts (cadr term))
                        (and (even? n) (nonzero? facts (cadr term)))))))
          (else #f)))))

(define (structural-factor? source target)
  (or (equal? (scalar-canonical source) (scalar-canonical target))
      (case (car source)
        ((*) (or (structural-factor? (cadr source) target) (structural-factor? (caddr source) target)))
        ((/) (or (structural-factor? (cadr source) target) (structural-factor? (caddr source) target)))
        ((-) (and (= (length source) 2) (structural-factor? (cadr source) target)))
        ((^) (let ((n (math-number-value (caddr source))))
               (and n (> n 0) (structural-factor? (cadr source) target))))
        (else #f))))

(define (parameter-factor? facts source target)
  (define (parameters-only? term)
    (every (lambda (path)
             (let ((local (math-term-at-path term path)))
               (or (not (eq? (car local) 'var)) (member `(parameter ,local) facts))))
           (math-term-paths term)))
  (and (parameters-only? source) (parameters-only? target)
       (catch 'polynomial-limit
         (lambda ()
           (let ((source (exact:math-term->polynomial source facts))
                 (target (exact:math-term->polynomial target facts)))
             (and source target (exact:polynomial-nonzero-factor? source target))))
         (lambda args #f))))

(define (nonzero? facts term)
  (let ((number (math-number-value term)))
    (or (and number (not (= number 0)))
        (asserted? facts 'nonzero term)
        (positive? facts term)
        (any (lambda (fact)
               (and (memq (car fact) '(nonzero positive))
                    (or (structural-factor? (cadr fact) term)
                        (parameter-factor? facts (cadr fact) term)))) facts)
        (case (car term)
          ((-) (and (= (length term) 2) (nonzero? facts (cadr term))))
          ((*) (and (nonzero? facts (cadr term)) (nonzero? facts (caddr term))))
          ((/) (and (nonzero? facts (cadr term)) (nonzero? facts (caddr term))))
          ((^)
           (let ((n (and (eq? (caaddr term) 'num) (math-natural-value (cadr (caddr term))))))
             (and n (or (= n 0) (nonzero? facts (cadr term))))))
          (else #f)))))

(define (math-premise-known? facts fact)
  (and (math-term? fact)
       (or (member fact facts)
           (case (car fact)
             ((positive) (positive? facts (cadr fact)))
             ((nonzero) (nonzero? facts (cadr fact)))
             ((smooth c2 differentiable) (regular? facts (cadr fact) (car fact)))
             (else #f))) #t))

(define (math-definedness-diagnostics facts term)
  (define (missing fact path)
    (and (not (math-premise-known? facts fact))
         (make-math-diagnostic #f #f path 'missing-premise (list fact)
           (format #f "missing domain premise: ~a" (math-term->source fact)))))
  (filter-map
    (lambda (path)
      (let ((local (math-term-at-path term path)))
        (case (car local)
          ((/)
           (if (equal? (math-number-value (caddr local)) 0)
               (make-math-diagnostic #f #f path 'division-by-zero '() "division by zero")
               (missing `(nonzero ,(caddr local)) (append path '(1)))))
          ((log)
           (let ((n (math-number-value (cadr local))))
             (if (and n (<= n 0))
                 (make-math-diagnostic #f #f (append path '(0)) 'domain-error '()
                   "real logarithm requires a positive argument")
                 (missing `(positive ,(cadr local)) (append path '(0))))))
          ((prime) (missing `(differentiable ,(cadr local)) (append path '(0))))
          ((partial) (missing `(differentiable ,(cadr local)) (append path '(0))))
          ((differentiate)
           (let ((premise (find (lambda (premise) (not (math-premise-known? facts premise)))
                                (math-function-differentiation-premises (cadr local)))))
             (and premise (missing premise (append path '(0))))))
          ((darg)
           (let ((info (math-function-derivative-info facts local)))
             (and info (missing (math-function-derivative-premise info) path))))
          (else #f))))
    (math-term-paths term)))
