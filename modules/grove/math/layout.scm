(define-module (grove math layout)
  #:use-module (grove ir)
  #:use-module (grove math term)
  #:use-module (grove math operator)
  #:use-module (grove math expression)
  #:use-module (grove math declaration)
  #:use-module ((grove math notation core) #:prefix notation:)
  #:use-module (srfi srfi-1)
  #:export (math-term->layout math-value->layout))

(define token notation:token)
(define row notation:row)
(define (operator value) (token 'mo value))
(define (parens value) (notation:parens (list value)))

(define (numeric-leading? term)
  (case (car term)
    ((num zero) #t)
    ((^ sub *) (numeric-leading? (cadr term)))
    (else #f)))

(define (numeric-coefficient? term)
  (or (eq? (car term) 'num)
      (and (eq? (car term) '-) (= (length term) 2)
           (eq? (caadr term) 'num))))

(define* (math-value->layout value #:optional (types '()))
  (unless (math-value? value) (error "expected a mathematical expression" value))
  (math-term->layout (math-value-term value)
    (delete-duplicates (append types (or (assq-ref (math-value-properties value) 'assumptions) '())) equal?)
    #:properties (math-value-properties value)))

(define* (math-term->layout term #:optional (types '()) #:key (properties '()))
  (define (lower value preferences)
    (unless (math-term? value) (error "invalid math term" value))
    (define children-properties (or (assq-ref preferences 'children) '()))
    (define (child index)
      (lower (list-ref (cdr value) index)
             (if (< index (length children-properties)) (list-ref children-properties index) '())))
    (define (argument index)
      (let ((layout (child index)))
        (if (eq? (content-element-kind layout) 'math-parens) layout (parens layout))))
    (define (operator-argument index)
      (if (memq (car (list-ref (cdr value) index)) '(var num zero)) (child index) (argument index)))
    (define (operand index)
      (let ((operand (list-ref (cdr value) index)))
        (if (or (and (memq (car value) '(* dot cross)) (memq (car operand) '(+ - = dot cross))
                     (not (and (eq? (car value) '*) (= index 0) (numeric-coefficient? operand))))
                (and (= index 1) (eq? (car value) '-) (memq (car operand) '(+ -)))
                (and (eq? (car value) '^) (memq (car operand) '(+ - * ^ =))))
            (argument index) (child index))))
    (define result
      (cond
        ((eq? (car value) 'var)
         (let ((identifier (token 'mi (symbol->string (cadr value)))))
           (if (member `(vector ,value) types)
               (notation:vec (list identifier)) identifier)))
        ((equal? value '(zero vector))
         (notation:vec (list (token 'mn "0"))))
        ((eq? (car value) 'num) (token 'mn (cadr value)))
        ((and (eq? (car value) 'differentiate) (= (length value) 3))
         (row (list (notation:frac
                      (list (token 'mi "d")) (list (token 'mi "d") (child 1)))
                    (argument 0))))
        ((eq? (car value) 'prime)
         (row (list (notation:sup (list (child 0)) (list (operator "′")))
                    (operator "⁡") (argument 1))))
        ((and (memq (car value) '(curl grad div laplacian)) (= (length value) 2))
         (row (append (case (car value)
                        ((curl) (list (operator "∇") (operator "×")))
                        ((grad) (list (operator "∇")))
                        ((div) (list (operator "∇") (operator "·")))
                        ((laplacian) (list (token 'mi "Δ"))))
                      (list (operator-argument 0)))))
        ((and (memq (car value) '(+ - * / = dot cross)) (= (length value) 3))
         (if (eq? (car value) '/)
             (notation:frac (list (child 0)) (list (child 1)))
             (row (append (list (operand 0))
                    (if (and (eq? (car value) '*) (numeric-coefficient? (cadr value))
                             (not (numeric-leading? (caddr value))))
                        '() (list (operator (math-operator-symbol (car value)))))
                    (list (operand 1))))))
        ((and (eq? (car value) '^) (= (length value) 3))
         (notation:sup (list (operand 0)) (list (child 1))))
        ((and (eq? (car value) '-) (= (length value) 2))
         (row (list (operator "−") (operator-argument 0))))
        (else
         (row (append (list
                       (let* ((identifier (token 'mi (symbol->string (car value))))
                              (signature (math-function-signature types (car value))))
                         (if (and signature (eq? (cadr signature) 'vector))
                             (notation:vec (list identifier)) identifier))
                       (operator "⁡") (operator "("))
                      (append-map (lambda (index)
                                    (append (if (zero? index) '() (list (operator ","))) (list (child index))))
                                  (iota (length (cdr value))))
                      (list (operator ")")))))))
    (let* ((result (if (assq-ref preferences 'parenthesized?) (parens result) result))
           (variant (assq-ref preferences 'variant)))
      (if variant (notation:style (list result) variant) result)))
  (lower term properties))
