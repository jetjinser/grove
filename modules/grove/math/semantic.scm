(define-module (grove math semantic)
  #:use-module (grove ir)
  #:use-module (grove math expression)
  #:use-module (grove math syntax)
  #:use-module (grove math term)
  #:use-module (grove math source)
  #:use-module (grove math declaration)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:re-export (math-value? math-value-term math-value-origin math-value-properties math-value-declarations math-value-requirements)
  #:export (expression expression-lines variable coordinate parameter function field space call constant add subtract negate multiply divide power dot cross
            sin cos exp log prime grad divergence curl laplacian derivative partial antiderivative poisson-particular components vector-zero group styled))

(define (fragments values)
  (append-map (lambda (value) (if (list? value) (fragments value) (list value))) values))

(define (syntax-preferences syntax embedded)
  (case (math-expression-kind syntax)
    ((embedded) (math-value-properties (assv-ref embedded (math-expression-start syntax))))
    ((group) (acons 'parenthesized? #t (syntax-preferences (car (math-expression-children syntax)) embedded)))
    (else
     (let ((children (map (lambda (child) (syntax-preferences child embedded)) (math-expression-children syntax))))
       (if (every null? children) '() (list (cons 'children children)))))))

(define (check-semantic-syntax syntax)
  (when (and (eq? (math-expression-kind syntax) 'binary)
             (eq? (math-expression-value syntax) 'subscript))
    (error "a subscript needs an explicit mathematical meaning; use Notation DSL for a layout-only script"))
  (for-each check-semantic-syntax (math-expression-children syntax)))

;; An embedded expression is an atomic operand, not a string to reparse.
;; Adjacent text fragments share a lexer, so fragment boundaries cannot split
;; an identifier or change the precedence of an operator.
(define-public (expression . values)
  (if (and (= (length values) 1) (math-value? (car values))) (car values)
      (let collect ((remaining (fragments values)) (offset 0)
                    (tokens '()) (text '()) (embedded '()))
        (cond
          ((null? remaining)
           (let* ((source (math-source-text (reverse text)))
                  (syntax (parse-math-tokens
                            (append (reverse tokens) (list (make-math-token 'eof "" offset offset))))))
             (check-semantic-syntax syntax)
             (make-math-value (math-expression->term syntax)
               #:origin (math-source-origin source #:syntax syntax
                          #:embedded (map (lambda (entry) (cons (car entry) (math-value-origin (cdr entry)))) embedded))
               #:properties (syntax-preferences syntax embedded)
               #:requirements (append-map (lambda (entry) (math-value-requirements (cdr entry))) embedded)
               #:declarations (delete-duplicates (append-map (lambda (entry) (math-value-declarations (cdr entry))) embedded) equal?))))
          ((math-value? (car remaining))
           (let ((value (car remaining)))
             (collect (cdr remaining) (+ offset 1)
               (cons (make-math-token 'embedded (math-value-term value) offset (+ offset 1)) tokens)
               (cons (string-copy " ") text)
               (acons offset value embedded))))
          ((or (string? (car remaining)) (content-text? (car remaining)) (content-layout? (car remaining)))
           (let* ((run (take-while (lambda (value) (or (string? value) (content-text? value) (content-layout? value))) remaining))
                  (source (math-source-text run))
                  (scanned (drop-right (tokenize-math source) 1)))
             (collect (drop remaining (length run)) (+ offset (string-length source))
               (append (reverse (map (lambda (token)
                                      (make-math-token (math-token-kind token) (math-token-value token)
                                        (+ offset (math-token-start token)) (+ offset (math-token-end token)))) scanned)) tokens)
               (append (reverse run) text) embedded)))
          (else (error "Semantic DSL requires mathematical operands; Notation DSL has no computational semantics"
                       (car remaining)))))))

;; A handwritten chain separates expressions by newlines, including newlines
;; represented as layout nodes by the at-exp reader. Operands remain objects.
(define-public (expression-lines . values)
  (define (nonblank? parts)
    (any (lambda (part) (or (math-value? part)
                           (not (string-every char-whitespace? part)))) parts))
  (let lines ((remaining (fragments values)) (pending '()) (output '()))
    (cond
      ((null? remaining)
       (reverse (if (nonblank? pending) (cons (apply expression (reverse pending)) output) output)))
      ((math-value? (car remaining)) (lines (cdr remaining) (cons (car remaining) pending) output))
      ((or (string? (car remaining)) (content-text? (car remaining)) (content-layout? (car remaining)))
       (let ((text (math-source-text (list (car remaining)))))
         (let split ((start 0) (pending pending) (output output))
           (let ((end (string-index text #\newline start)))
             (if end
                 (let ((pending (cons (math-source-slice text start end) pending)))
                   (split (+ end 1) '()
                     (if (nonblank? pending) (cons (apply expression (reverse pending)) output) output)))
                 (lines (cdr remaining) (cons (math-source-slice text start (string-length text)) pending) output))))))
      (else (error "handwritten semantic chains require mathematical expressions" (car remaining))))))

(define-public (variable name)
  (let ((value (expression (if (symbol? name) (symbol->string name) name))))
    (unless (eq? (car (math-value-term value)) 'var) (error "expected a variable name" name)) value))

(define-public (constant value)
  (unless (and (rational? value) (exact? value)) (error "expected an exact rational constant" value))
  (make-math-value
    (let ((n (numerator value)) (d (denominator value)))
      (let ((term (if (= d 1) `(num ,(number->string (abs n)))
                      `(/ (num ,(number->string (abs n))) (num ,(number->string d))))))
        (if (< n 0) `(- ,term) term)))))

(define (declared-variable role name)
  (let ((value (variable name)))
    (make-math-value (math-value-term value) #:origin (math-value-origin value)
      #:requirements (math-value-requirements value)
      #:declarations (list (list role (math-value-term value))))))
(define-public (coordinate name) (declared-variable 'coordinate name))
(define-public (parameter name) (declared-variable 'parameter name))

(define-public (space x y z)
  (when (any (lambda (axis)
               (and (math-value? axis)
                    (member `(parameter ,(math-value-term axis)) (math-value-declarations axis))))
             (list x y z))
    (error "Cartesian axes cannot be constant parameters"))
  (let* ((coordinates (map coordinate (list x y z)))
         (fact (cons 'space (map math-value-term coordinates))))
    (unless (math-space-declaration? fact) (error "expected three distinct Cartesian coordinates" fact))
    (make-math-value fact #:declarations
      (cons fact (append-map math-value-declarations coordinates)))))

(define* (field name #:key space (result 'scalar))
  (unless (and (math-value? space) (math-space-declaration? (math-value-term space)))
    (error "field requires a Cartesian space value" space))
  (let* ((value (variable name))
         (fact `(field ,(math-value-term value) (var ,result) ,@(cdr (math-value-term space)))))
    (unless (math-field-declaration? fact) (error "invalid field declaration" fact))
    (make-math-value (math-value-term value) #:declarations (list fact)
      #:requirements (list (math-value-term space)))))
(define* (function name #:key (inputs '(scalar)) (result 'scalar))
  (let* ((value (variable name))
         (declaration `(function ,(math-value-term value) ,@(map (lambda (type) `(var ,type)) (append inputs (list result))))))
    (unless (math-function-declaration? declaration) (error "invalid mathematical function signature" declaration))
    (make-math-value (math-value-term value) #:origin (math-value-origin value)
      #:requirements (math-value-requirements value) #:declarations (list declaration))))

(define-public (call function . operands)
  (let* ((function (variable function))
         (value (operation (cadr (math-value-term function)) operands)))
    (make-math-value (math-value-term value) #:origin (math-value-origin value)
      #:properties (math-value-properties value)
      #:requirements (append (math-value-requirements function) (math-value-requirements value))
      #:declarations (delete-duplicates (append (math-value-declarations function) (math-value-declarations value)) equal?))))

(define (operation name operands)
  (let ((values (map (lambda (operand) (expression operand)) operands)))
    (make-math-value (cons name (map math-value-term values))
      #:origin (math-branch-origin (map math-value-origin values))
      #:properties (list (cons 'children (map math-value-properties values)))
      #:requirements (append-map math-value-requirements values)
      #:declarations (delete-duplicates (append-map math-value-declarations values) equal?))))

(define-public (add left right) (operation '+ (list left right)))
(define-public (subtract left right) (operation '- (list left right)))
(define-public (negate operand) (operation '- (list operand)))
(define-public (multiply left right) (operation '* (list left right)))
(define-public (dot left right) (operation 'dot (list left right)))
(define-public (cross left right) (operation 'cross (list left right)))
(define-public (divide numerator denominator) (operation '/ (list numerator denominator)))
(define-public (power base exponent) (operation '^ (list base exponent)))
(define-public (sin . body) (operation 'sin (list body)))
(define-public (cos . body) (operation 'cos (list body)))
(define-public (exp . body) (operation 'exp (list body)))
(define-public (log . body) (operation 'log (list body)))
(define-public (prime function . body) (operation 'prime (list (variable function) body)))
(define-public (grad . body) (operation 'grad (list body)))
(define-public (divergence . body) (operation 'div (list body)))
(define-public (curl . body) (operation 'curl (list body)))
(define-public (laplacian . body) (operation 'laplacian (list body)))
(define-public (derivative operand coordinate) (operation 'differentiate (list operand (variable coordinate))))
(define-public (partial operand coordinate)
  "Construct an explicit partial derivative; evaluation requires an independent coordinate."
  (operation 'partial (list operand (variable coordinate))))

(define* (components x y z #:key space)
  "Construct three scalar components in SPACE's ordered Cartesian basis.
The space remains a requirement, not an automatically activated assumption."
  (unless (and (math-value? space) (math-space-declaration? (math-value-term space)))
    (error "components require a Cartesian space value" space))
  (let ((value (operation 'components (list x y z))))
    (make-math-value (math-value-term value)
      #:origin (math-value-origin value) #:properties (math-value-properties value)
      #:declarations (math-value-declarations value)
      #:requirements (cons (math-value-term space) (math-value-requirements value)))))
(define-public (vector-zero) (make-math-value '(zero vector)))
(define-public (group . body)
  (let ((value (apply expression body)))
    (math-value-with-properties value (acons 'parenthesized? #t (math-value-properties value)))))

(define-public styled
  (lambda* (value #:key (variant 'normal))
    (unless (memq variant '(normal bold italic bold-italic)) (error "unsupported math variant" variant))
    (let ((value (expression value)))
      (math-value-with-properties value (acons 'variant variant (math-value-properties value))))))

(define-public (antiderivative expression coordinate)
  (operation 'antiderivative (list expression coordinate)))
(define-public (poisson-particular expression coordinate)
  (operation 'poisson (list expression coordinate)))
