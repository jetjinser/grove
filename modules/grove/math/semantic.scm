(define-module (grove math semantic)
  #:use-module (grove ir)
  #:use-module (grove math expression)
  #:use-module (grove math term)
  #:use-module ((grove math private identifier) #:select (math-identifier?))
  #:use-module (grove math source)
  #:use-module (grove math private declaration)
  #:use-module (srfi srfi-1)
  #:re-export (math-value? math-value-term math-value-origin math-value-properties math-value-declarations math-value-requirements)
  #:export (variable coordinate parameter function field space call constant add subtract negate multiply divide power dot cross
            sin cos exp log prime grad divergence curl laplacian derivative partial function-partial antiderivative poisson-particular components vector-zero group styled))

(define-public (variable name)
  (let ((text (cond ((symbol? name) (symbol->string name))
                    ((string? name) name)
                    (else (error "expected a variable name" name)))))
    (unless (math-identifier? text)
      (error "expected a variable identifier" name))
    (let ((name (string->symbol text)))
      (make-math-value `(var ,name)))))

(define-public (constant value)
  (unless (and (rational? value) (exact? value)) (error "expected an exact rational constant" value))
  (make-math-value
    (let ((n (numerator value)) (d (denominator value)))
      (let ((term (if (= d 1) `(num ,(number->string (abs n)))
                      `(/ (num ,(number->string (abs n))) (num ,(number->string d))))))
        (if (< n 0) `(- ,term) term)))))

(define (declared-variable role name)
  (let ((value (variable name)))
    (make-math-value (math-value-term value) #:origin (math-value-origin value)
      #:requirements (math-value-requirements value)
      #:declarations (list (list role (math-value-term value))))))
(define-public (coordinate name) (declared-variable 'coordinate name))
(define-public (parameter name) (declared-variable 'parameter name))

(define-public (space x y z)
  (when (any (lambda (axis)
               (and (math-value? axis)
                    (member `(parameter ,(math-value-term axis)) (math-value-declarations axis))))
             (list x y z))
    (error "Cartesian axes cannot be constant parameters"))
  (let* ((coordinates (map coordinate (list x y z)))
         (fact (cons 'space (map math-value-term coordinates))))
    (unless (math-space-declaration? fact) (error "expected three distinct Cartesian coordinates" fact))
    (make-math-value fact #:declarations
      (cons fact (append-map math-value-declarations coordinates)))))

(define* (field name #:key space (result 'scalar))
  (unless (and (math-value? space) (math-space-declaration? (math-value-term space)))
    (error "field requires a Cartesian space value" space))
  (let* ((value (variable name))
         (fact `(field ,(math-value-term value) (var ,result) ,@(cdr (math-value-term space)))))
    (unless (math-field-declaration? fact) (error "invalid field declaration" fact))
    (make-math-value (math-value-term value) #:declarations (list fact)
      #:requirements (list (math-value-term space)))))
(define* (function name #:key (inputs '(scalar)) (result 'scalar))
  (let* ((value (variable name))
         (declaration `(function ,(math-value-term value) ,@(map (lambda (type) `(var ,type)) (append inputs (list result))))))
    (unless (math-function-declaration? declaration) (error "invalid mathematical function signature" declaration))
    (make-math-value (math-value-term value) #:origin (math-value-origin value)
      #:requirements (math-value-requirements value) #:declarations (list declaration))))

(define-public (call function . operands)
  (let* ((function (if (math-value? function) function (variable function)))
         (function-term (math-value-term function))
         (name (if (and (list? function-term) (= (length function-term) 2)
                        (eq? (car function-term) 'var))
                   (cadr function-term)
                   (error "Semantic call requires a function identifier" function)))
         (value (operation name operands)))
    (make-math-value (math-value-term value) #:origin (math-value-origin value)
      #:properties (math-value-properties value)
      #:requirements (append (math-value-requirements function) (math-value-requirements value))
      #:declarations (delete-duplicates (append (math-value-declarations function) (math-value-declarations value)) equal?))))

(define (operation name operands)
  (let ((values (map (lambda (operand)
                       (unless (math-value? operand)
                         (error "Semantic operations require Semantic values" operand))
                       operand)
                     operands)))
    (make-math-value (cons name (map math-value-term values))
      #:origin (math-branch-origin (map math-value-origin values))
      #:properties (list (cons 'children (map math-value-properties values)))
      #:requirements (append-map math-value-requirements values)
      #:declarations (delete-duplicates (append-map math-value-declarations values) equal?))))

(define-public (add left right) (operation '+ (list left right)))
(define-public (subtract left right) (operation '- (list left right)))
(define-public (negate operand) (operation '- (list operand)))
(define-public (multiply left right) (operation '* (list left right)))
(define-public (dot left right) (operation 'dot (list left right)))
(define-public (cross left right) (operation 'cross (list left right)))
(define-public (divide numerator denominator) (operation '/ (list numerator denominator)))
(define-public (power base exponent) (operation '^ (list base exponent)))
(define-public (sin value) (operation 'sin (list value)))
(define-public (cos value) (operation 'cos (list value)))
(define-public (exp value) (operation 'exp (list value)))
(define-public (log value) (operation 'log (list value)))
(define-public (prime function value)
  (let ((function (if (math-value? function) function (variable function))))
    (unless (and (list? (math-value-term function))
                 (= (length (math-value-term function)) 2)
                 (eq? (car (math-value-term function)) 'var))
      (error "prime requires a function identifier" function))
    (operation 'prime (list function value))))
(define-public (grad value) (operation 'grad (list value)))
(define-public (divergence value) (operation 'div (list value)))
(define-public (curl value) (operation 'curl (list value)))
(define-public (laplacian value) (operation 'laplacian (list value)))
(define-public (derivative operand coordinate) (operation 'differentiate (list operand coordinate)))
(define-public (partial operand coordinate)
  "Construct an explicit partial derivative; evaluation requires an independent coordinate."
  (operation 'partial (list operand coordinate)))

(define-public (function-partial application index)
  "Differentiate the applied function in argument position INDEX (one-based)."
  (unless (and (exact-integer? index) (> index 0)) (error "expected a positive argument index" index))
  (operation 'darg (list application (constant index))))

(define* (components x y z #:key space)
  "Construct three scalar components in SPACE's ordered Cartesian basis.
The space remains a requirement, not an automatically activated assumption."
  (unless (and (math-value? space) (math-space-declaration? (math-value-term space)))
    (error "components require a Cartesian space value" space))
  (let ((value (operation 'components (list x y z))))
    (make-math-value (math-value-term value)
      #:origin (math-value-origin value) #:properties (math-value-properties value)
      #:declarations (math-value-declarations value)
      #:requirements (cons (math-value-term space) (math-value-requirements value)))))
(define-public (vector-zero) (make-math-value '(zero vector)))
(define-public (group . body)
  (unless (and (= (length body) 1) (math-value? (car body)))
    (error "Semantic group requires one Semantic value" body))
  (let ((value (car body)))
    (math-value-with-properties value
      (acons 'parenthesized? #t (math-value-properties value)))))

(define-public styled
  (lambda* (value #:key (variant 'normal))
    (unless (memq variant '(normal bold italic bold-italic)) (error "unsupported math variant" variant))
    (unless (math-value? value) (error "Semantic styling requires a Semantic value" value))
    (math-value-with-properties value (acons 'variant variant (math-value-properties value)))))

(define-public (antiderivative expression coordinate)
  (operation 'antiderivative (list expression coordinate)))
(define-public (poisson-particular expression coordinate)
  (operation 'poisson (list expression coordinate)))
