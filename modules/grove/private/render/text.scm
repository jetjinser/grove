(define-module (grove private render text)
  #:use-module ((grove private ir) #:prefix ir:)
  #:use-module (grove ir)
  #:use-module (grove render rules)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (content->text/internal))

(define* (content->text/internal content #:key (internal-handlers '())
                                 (internal-lazy-handlers '())
                                 (rules empty-render-rules) (context #f))
  (define (render content)
    (cond
      ((string? content) content)
      ((content-text? content) (ir:content-text-value/raw content))
      ((content-layout? content) (ir:content-layout-raw/raw content))
      ((content-element? content) (render-element content))
      ((content-document? content)
       (string-concatenate
         (map render (ir:content-document-children/raw content))))
      (else (error "not a content node" content))))

  (define (default-element-text element body)
    (case (content-element-kind element)
      ((paragraph) (string-append body "\n"))
      ((summary) (string-append body "\n"))
      ((disclosure subtree)
       (string-append (ir:content-element-property/raw element 'title)
                      "\n" body))
      ((section)
       (string-append (ir:content-element-property/raw element 'title)
                      "\n" body))
      ((math-derivation)
       (let ((children (ir:content-element-children/raw element)))
         (if (and (= (length children) 2)
                  (content-element? (cadr children))
                  (memq (content-element-kind (cadr children))
                        '(details disclosure subtree)))
             (render (cadr children)) body)))
      ((blockquote)
       (string-append
         (string-join
           (map (lambda (line) (string-append "> " line))
                (string-split body #\newline))
           "\n")
         "\n"))
      ((item) (string-append "- " body "\n"))
      ((code) (string-append "`" body "`"))
      ((code-block)
       (string-append "```\n" body
                      (if (string-suffix? "\n" body) "" "\n")
                      "```\n"))
      ((math)
       (let ((source-text body))
         (if (ir:content-element-property/raw element 'tex?)
             (if (ir:content-element-property/raw element 'display?)
                 (string-append "$$\n" source-text "\n$$\n")
                 (string-append "$" source-text "$"))
             source-text)))
      ((math-token) body)
      ((math-frac)
       (let ((children (ir:content-element-children/raw element)))
         (string-append (render (car children))
                        "/"
                        (render (cadr children)))))
      ((math-sup)
       (let ((children (ir:content-element-children/raw element)))
         (string-append (render (car children))
                        "^"
                        (render (cadr children)))))
      ((math-sub)
       (let ((children (ir:content-element-children/raw element)))
         (string-append (render (car children))
                        "_"
                        (render (cadr children)))))
      ((math-vector) (string-append body "⃗"))
      ((math-parens) (string-append "(" body ")"))
      ((math-column)
       (string-append "(" (string-join (map render (ir:content-element-children/raw element)) ", ") ")"))
      ((math-align)
       (string-concatenate
         (map (lambda (row) (string-append (render row) "\n"))
              (ir:content-element-children/raw element))))
      ((math-row)
       (let ((children (ir:content-element-children/raw element)))
         (if (every (lambda (child)
                      (and (content-element? child)
                           (eq? (content-element-kind child) 'math-cell)))
                    children)
             (string-join (filter (lambda (text) (not (string-null? text)))
                                  (map render children)) " ")
             body)))
      ((math-cell) body)
      (else body)))

  (define (render-element element)
    (let* ((kind (content-element-kind element))
           (lazy-handler (assq-ref internal-lazy-handlers kind)))
      (if lazy-handler
          (lazy-handler element render)
          (let* ((body (string-concatenate
                         (map render (ir:content-element-children/raw element))))
                 (handler (assq-ref internal-handlers kind))
                 (rule (and rules (render-rules-ref rules kind))))
            (if (eq? kind 'math)
                (default-element-text element body)
                (if rule
                    (rule context element body
                          (lambda ()
                            (if handler
                                (handler element body)
                                (default-element-text element body))))
                    (if handler
                        (handler element body)
                        (default-element-text element body))))))))

  (render content))
