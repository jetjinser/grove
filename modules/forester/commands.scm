(define-module (forester commands)
  #:use-module (grove ir)
  #:export (title link))

(define (title . body)
  (make-content-element 'title body))

(define* (link target . label)
  (make-content-element 'link
                        (if (null? label) (list target) label)
                        #:properties `((target . ,target))))
