if has nix; then
  watch_file nix/flake.nix
  watch_file nix/flake.lock
  use flake ./nix
fi
if has guix; then
  watch_file channels.scm manifest.scm
  eval "$(guix time-machine -C channels.scm -- shell -m manifest.scm --search-paths)"
fi
